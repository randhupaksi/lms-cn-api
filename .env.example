APP_ENV=development
PORT=8080
API_PREFIX=/api/v1
APP_NAME=Citra Negara LMS API
MIGRATIONS_PATH=migrations
DATABASE_URL=user:password@tcp(localhost:3306)/lms_cn?charset=utf8mb4&parseTime=True&loc=Local
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=
COOKIE_SECURE=false
DATABASE_MAX_OPEN=50
DATABASE_MAX_IDLE=10
DATABASE_MAX_LIFETIME=30m
SHUTDOWN_TIMEOUT=10s
LOGIN_RATE_LIMIT=2500
LOGIN_RATE_WINDOW=1m
LOGIN_ACCOUNT_RATE_LIMIT=10
LOGIN_ACCOUNT_RATE_WINDOW=5m
SEED_DEMO_DATA=true
